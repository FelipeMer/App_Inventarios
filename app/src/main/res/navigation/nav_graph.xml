<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.codebyfelipe.appinventarios.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.codebyfelipe.appinventarios.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/productListFragment"
        android:name="com.codebyfelipe.appinventarios.ui.catalog.product.ProductListFragment"
        android:label="Catálogo"
        tools:layout="@layout/fragment_product_list">
        <action
            android:id="@+id/action_productListFragment_to_productFormFragment"
            app:destination="@id/productFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/movementsMenuFragment"
        android:name="com.codebyfelipe.appinventarios.ui.movements.MovementsMenuFragment"
        android:label="Movimientos"
        tools:layout="@layout/fragment_movements_menu" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.codebyfelipe.appinventarios.ui.profile.ProfileFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/productFormFragment"
        android:name="com.codebyfelipe.appinventarios.ui.catalog.product.ProductFormFragment"
        android:label="Producto"
        tools:layout="@layout/fragment_product_form">

        <argument
            android:name="productoId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_productFormFragment_to_barcodeScannerFragment"
            app:destination="@id/barcodeScannerFragment" />

    </fragment>

    <fragment
        android:id="@+id/barcodeScannerFragment"
        android:name="com.codebyfelipe.appinventarios.ui.scanner.BarcodeScannerFragment"
        android:label="Escanear"
        tools:layout="@layout/fragment_barcode_scanner" />

    <action
        android:id="@+id/action_global_to_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</navigation>